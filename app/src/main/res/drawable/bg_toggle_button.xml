<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- включено: тёмный фон + акцентная обводка -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_on_fill" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- выключено -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_off_bg" />
            <stroke android:width="1dp" android:color="@color/btn_off_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
